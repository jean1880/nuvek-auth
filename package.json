{
  "name": "@nuvek/auth",
  "version": "0.1.0",
  "description": "Vue 3 Auth0 (Authorization Code + PKCE) client for nuvek SPAs, paired with the nuvek-auth Rust crate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jean1880/nuvek-auth.git"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "module": "./dist/nuvek-auth.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nuvek-auth.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
